{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sufra",
  "compatibility_date": "2026-10-28",
  "main": "src/worker.js",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "API_URL": "https://sufra-backend.onrender.com"
  },
  "observability": {
    "enabled": true
  }
}
